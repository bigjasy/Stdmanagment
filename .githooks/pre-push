#!/bin/sh
echo "Running tests before push..."
if ! command -v mvn >/dev/null 2>&1; then
    echo "Maven not found. Push cancelled."
    exit 1
fi
mvn -B test
status=$?
if [ "$status" -ne 0 ]; then
    echo "Tests failed! Push cancelled."
    exit "$status"
fi
echo "All tests passed! Push allowed."
exit 0
